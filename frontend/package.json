{
  "name": "ckdutch-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:crypto": "wasm-pack build crypto --target web --out-dir pkg --release",
    "build": "bun run build:crypto && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:crypto": "cargo test --manifest-path crypto/Cargo.toml && node --test crypto/test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "near-kit": "0.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wasm-pack": "0.15.0"
  },
  "trustedDependencies": [
    "wasm-pack"
  ]
}
